 /***********************************************************************
+ *		madeira_raise_dispatch
+ *
+ * SRTRelay: RtlCaptureContext runs in the JIT-pool copy, so ExceptionAddress was a pool
+ * address outside every module (Dungeons: 0x150d0c110 instead of kernelbase+0x18110).
+ * Handlers that check where an exception came from see the PE address again.
+ */
+NTSTATUS WINAPI madeira_raise_dispatch( EXCEPTION_RECORD *rec, CONTEXT *context )
+{
+    void *addr = xlate_ios_jit_rev( rec->ExceptionAddress );
+
+    /* no static counter: ntdll's .data layout (exported ios_xp_nt) must not move */
+    if (addr != rec->ExceptionAddress && rec->ExceptionCode != 0xe06d7363 /* C++ */ &&
+        rec->ExceptionCode != 0x406d1388 /* thread name */ && rec->ExceptionCode != DBG_PRINTEXCEPTION_C &&
+        rec->ExceptionCode != DBG_PRINTEXCEPTION_WIDE_C)
+        ERR( "[raise-addr] code=%lx ExceptionAddress %p -> %p\n", rec->ExceptionCode, rec->ExceptionAddress, addr );
+    rec->ExceptionAddress = addr;
+    return dispatch_exception( rec, context );
+}
+
+
