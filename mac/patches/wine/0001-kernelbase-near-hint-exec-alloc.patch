+/* iOS-Madeira: NtWriteVirtualMemory goes through the wineserver, whose
+ * write_process_memory cannot make an executable page writable on iOS and
+ * fails with STATUS_ACCESS_DENIED -- Minecraft Dungeons' winmm.dll writes its
+ * hook trampoline (5 bytes into an executable page it just allocated) that
+ * way and gives up on the error. In the calling process the page is mapped
+ * right here, so copy directly; a fault falls back to the server path. */
+static NTSTATUS write_own_memory( HANDLE process, void *addr, const void *buffer,
+                                  SIZE_T size, SIZE_T *bytes_written )
+{
+    if (process == GetCurrentProcess() || GetProcessId( process ) == GetCurrentProcessId())
+    {
+        BOOL ok = TRUE;
+        __TRY
+        {
+            memcpy( addr, buffer, size );
+        }
+        __EXCEPT_PAGE_FAULT
+        {
+            ok = FALSE;
+        }
+        __ENDTRY
+        if (ok)
+        {
+            NEAR_TRACE( "WriteProcessMemory: %#Ix bytes copied directly to %p\n", size, addr );
+            if (bytes_written) *bytes_written = size;
+            return STATUS_SUCCESS;
+        }
+        NEAR_TRACE( "WriteProcessMemory: direct copy to %p faulted, using the server\n", addr );
+    }
+    return NtWriteVirtualMemory( process, addr, buffer, size, bytes_written );
+}
