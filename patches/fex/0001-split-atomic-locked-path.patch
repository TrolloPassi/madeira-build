+// Madeira split-atomic patch: an x86 locked access whose operand crosses a
+// 16-byte boundary faults as an LSE atomic on the host. FEX emulates it in the
+// SIGBUS/Mach path but never backpatches LSE atomics, so a hot site pays a full
+// exception round trip on every execution (Minecraft Dungeons: ~800k at one
+// site). Instead, check the address inline (no NZCV change) and run crossing
+// accesses under one process-wide lock with plain loads and stores.
+alignas(64) static uint32_t MadeiraSplitAtomicLock = 0;
+enum class SplitAtomicOp { CAS, Swap, Add, Sub, And, Clr, Or, Xor, Neg };
+
+#define MADEIRA_SPLIT_CHECK(MemSrc, Bytes, SlowLabel)                         \
+  const bool SplitCheck = (Bytes) > 1;                                         \
+  if (SplitCheck) {                                                            \
+    /* TMP1 = (addr & 15) + Bytes - 17: >= 0 iff the access crosses 16B */     \
+    and_(ARMEmitter::Size::i64Bit, TMP1, MemSrc, uint64_t {15});                        \
+    sub(ARMEmitter::Size::i64Bit, TMP1, TMP1, uint32_t(17 - (Bytes)));                 \
+    (void)tbz(TMP1, 63, SlowLabel);                                            \
+  }
+
+#define MADEIRA_SPLIT_SLOW(Kind, MemSrc, SubEmitSize, EmitSize, Bytes, Value, Desired, Dst) \
+  do {                                                                         \
+    dmb(ARMEmitter::BarrierScope::ISH);                                        \
+    LoadConstant(ARMEmitter::Size::i64Bit, TMP1, reinterpret_cast<uint64_t>(&MadeiraSplitAtomicLock)); \
+    ARMEmitter::BackwardLabel LockRetry;                                       \
+    (void)Bind(&LockRetry);                                                    \
+    ldaxr(TMP2.W(), TMP1);                                                     \
+    (void)cbnz(ARMEmitter::Size::i32Bit, TMP2, &LockRetry);                    \
+    movz(ARMEmitter::Size::i32Bit, TMP2, 1);                                   \
+    stxr(TMP3.W(), TMP2.W(), TMP1);                                            \
+    (void)cbnz(ARMEmitter::Size::i32Bit, TMP3, &LockRetry);                    \
+    ldr(SubEmitSize, TMP2, MemSrc);                                            \
+    ARMEmitter::ForwardLabel NoStore;                                          \
+    switch (Kind) {                                                            \
+    case SplitAtomicOp::CAS:                                                   \
+      eor((Bytes) == 8 ? ARMEmitter::Size::i64Bit : ARMEmitter::Size::i32Bit, TMP3, TMP2, Value); \
+      if ((Bytes) == 2) and_(ARMEmitter::Size::i32Bit, TMP3, TMP3, uint64_t {0xFFFF});    \
+      (void)cbnz((Bytes) == 8 ? ARMEmitter::Size::i64Bit : ARMEmitter::Size::i32Bit, TMP3, &NoStore); \
+      str(SubEmitSize, Desired, MemSrc);                                       \
+      break;                                                                   \
+    case SplitAtomicOp::Swap: str(SubEmitSize, Value, MemSrc); break;          \
+    case SplitAtomicOp::Add: add(EmitSize, TMP3, TMP2, Value); str(SubEmitSize, TMP3, MemSrc); break; \
+    case SplitAtomicOp::Sub: sub(EmitSize, TMP3, TMP2, Value); str(SubEmitSize, TMP3, MemSrc); break; \
+    case SplitAtomicOp::And: and_(EmitSize, TMP3, TMP2, Value); str(SubEmitSize, TMP3, MemSrc); break; \
+    case SplitAtomicOp::Clr: bic(EmitSize, TMP3, TMP2, Value); str(SubEmitSize, TMP3, MemSrc); break; \
+    case SplitAtomicOp::Or: orr(EmitSize, TMP3, TMP2, Value); str(SubEmitSize, TMP3, MemSrc); break; \
+    case SplitAtomicOp::Xor: eor(EmitSize, TMP3, TMP2, Value); str(SubEmitSize, TMP3, MemSrc); break; \
+    case SplitAtomicOp::Neg: neg(EmitSize, TMP3, TMP2); str(SubEmitSize, TMP3, MemSrc); break; \
