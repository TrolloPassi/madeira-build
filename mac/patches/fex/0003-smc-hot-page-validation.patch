+static size_t SMCHotPageSlot(uint64_t Key, size_t Size) {
+  return static_cast<size_t>((Key * 0x9E3779B97F4A7C15ULL) >> 40) & (Size - 1);
+}
+
+void ContextImpl::MarkSMCHotPage(uint64_t Address) {
+  // SRTRelay: iOS maps guest code RX with 16K pages; mark every 4K page of the 16K page so writes
+  // emulated next to the faulting one (e.g. Wine's unaligned CAS emulation) are covered too.
+  const uint64_t Base = Address & ~uint64_t {0x3FFF};
+  for (uint64_t Sub = 0; Sub < 0x4000; Sub += 0x1000) {
+    const uint64_t Key = ((Base + Sub) >> 12) + 1;
+    size_t Idx = SMCHotPageSlot(Key, SMCHotPages.size());
+    for (size_t i = 0; i < SMCHotPages.size(); ++i, Idx = (Idx + 1) & (SMCHotPages.size() - 1)) {
+      uint64_t Cur = SMCHotPages[Idx].load(std::memory_order_acquire);
+      if (Cur == Key) {
+        break;
+      }
+      if (Cur == 0) {
+        if (SMCHotPages[Idx].compare_exchange_strong(Cur, Key, std::memory_order_acq_rel)) {
+          const auto N = SMCHotPageCount.fetch_add(1, std::memory_order_relaxed) + 1;
+          if (N <= 64) {
+            LogMan::Msg::IFmt("[smc-hot] page {:X} now validates every instruction (#{})", Base + Sub, N);
+          }
+          break;
+        }
+        if (Cur == Key) {
+          break;
+        }
+      }
+    }
+  }
+}
+
+bool ContextImpl::IsSMCHotPage(uint64_t Address) const {
+  const uint64_t Key = (Address >> 12) + 1;
+  size_t Idx = SMCHotPageSlot(Key, SMCHotPages.size());
+  for (size_t i = 0; i < SMCHotPages.size(); ++i, Idx = (Idx + 1) & (SMCHotPages.size() - 1)) {
+    const uint64_t Cur = SMCHotPages[Idx].load(std::memory_order_acquire);
+    if (Cur == Key) {
+      return true;
+    }
+    if (Cur == 0) {
+      return false;
+    }
+  }
+  return false;
+}
